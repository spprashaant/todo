<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts (long-press the app icon). Each opens MainActivity with a dev.coderlog.todos:// URL
     that app/js/native.js reads through App.getLaunchUrl() / appUrlOpen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new"
        android:shortcutShortLabel="@string/shortcut_new_short"
        android:shortcutLongLabel="@string/shortcut_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="dev.coderlog.todos://new"
            android:targetPackage="dev.coderlog.todos"
            android:targetClass="dev.coderlog.todos.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="dev.coderlog.todos://today"
            android:targetPackage="dev.coderlog.todos"
            android:targetClass="dev.coderlog.todos.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="dev.coderlog.todos://search"
            android:targetPackage="dev.coderlog.todos"
            android:targetClass="dev.coderlog.todos.MainActivity" />
    </shortcut>
</shortcuts>
