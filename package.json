{
  "name": "todo",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "suite": "bash tools/suite.sh",
    "shoot": "node tools/shoot.mjs",
    "deploy": "wrangler pages deploy app --project-name todos --branch main --commit-dirty=true",
    "preview": "wrangler dev",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:assets": "node scripts/generate-assets.mjs",
    "android:sounds": "node scripts/generate-sounds.mjs",
    "vendor:capacitor": "cp node_modules/@capacitor/core/dist/index.js app/vendor/capacitor-core.mjs && cp node_modules/@capacitor/core/LICENSE app/vendor/capacitor-core-LICENSE",
    "native:check": "node scripts/native-check.mjs && node scripts/native-back-check.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "playwright": "^1.63.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
